# Copy to .env.local. Never commit real keys.

# Hosted demo only: lets /api/tag tag photos with the maintainer's key.
# Leave false for self-hosting; users paste their own key in Settings instead.
NEXT_PUBLIC_DEMO_MODE=false

# Server-side only. Read by /api/tag when NEXT_PUBLIC_DEMO_MODE=true.
ANTHROPIC_API_KEY=
